	measure 'Total Receipts' =
			SUM ( fact_finance[total_receipts] )
		lineageTag: 112bb183-837a-5eeb-8b1a-040847307529
		formatString: "$#,0"

	measure 'House Receipts' =
			CALCULATE (
			    SUM ( fact_finance[total_receipts] ),
			    fact_finance[office] = "H"
			)
		lineageTag: a1bc859f-a4e6-5b7a-b369-5c421a4af793
		formatString: "$#,0"

	measure 'Senate Receipts' =
			CALCULATE (
			    SUM ( fact_finance[total_receipts] ),
			    fact_finance[office] = "S"
			)
		lineageTag: 9febf7a7-e848-5e89-bc92-8b263ab35315
		formatString: "$#,0"

	measure 'Candidates Count' =
			COUNTROWS ( fact_finance )
		lineageTag: 4e6b029d-7c65-586c-8b0e-daba94e3368b

	partition fact_finance = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(RepoFolder & "/powerbi/gold/fact_finance.csv"),[Delimiter=",", Columns=22, Encoding=65001, QuoteStyle=QuoteStyle.None]),
